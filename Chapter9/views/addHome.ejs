<%- include('partials/head') %>
<%- include('partials/header') %>

<body class="bg-gray-50 text-gray-800">

  <div class="bg-white shadow mt-20 p-6 text-center">
    <h1 class="text-3xl font-bold text-red-500">Register Your Home</h1>
    <p class="text-gray-600 mt-2">Enter your home details below</p>
</div>

  <main class="flex justify-center items-center min-h-[60vh]">
    <form action="/host/add-home" method="POST" 
          class="bg-white p-8 rounded-2xl shadow-lg w-full max-w-md space-y-5">
      
      <input type="text" name="homeName" placeholder="Home Name"
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-400 outline-none" required>

      <input type="text" name="homeLocation" placeholder="Home Location"
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-400 outline-none" required>
                <input type="text" name="Price" placeholder="Price per Night"
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-400 outline-none" required>
                 <input type="text" name="Rating" placeholder="Rating"
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-400 outline-none" required> 
                 <input type="text" name="PhotoUrl" placeholder="Enter Photo URL"
             class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-400 outline-none" required>
      <button type="submit" 
              class="w-full py-3 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition">
        Add Home
      </button>
    </form>
  </main>
</body>
</html>
